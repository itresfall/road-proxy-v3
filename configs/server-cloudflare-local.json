{
  "tcp": {
    "listen_addr": "127.0.0.1:25567",
    "buffer_size": 32768,
    "dial_timeout": "5s",
    "keep_alive_period": "30s"
  },
  "http": {
    "enabled": true,
    "listen_addr": "127.0.0.1:8080",
    "ws_endpoint": "/ws",
    "auth_token": "env:ROAD_WS_TOKEN",
    "auth_header": "X-ROAD-Token",
    "allowed_origins": [
      "https://road.example.com"
    ],
    "allowed_hosts": [
      "road.example.com"
    ],
    "trust_proxy_headers": true,
    "max_connections": 128,
    "max_connections_per_ip": 16,
    "rate_limit_per_minute": 60,
    "ws_idle_timeout": "2m0s",
    "ws_ping_interval": "30s",
    "max_ws_message_bytes": 1048576,
    "enable_compression": false,
    "read_timeout": "10s",
    "write_timeout": "10s",
    "handshake_timeout": "5s",
    "read_header_timeout": "5s",
    "max_header_bytes": 1048576
  },
  "control": {
    "enabled": true,
    "listen_addr": "127.0.0.1:8081",
    "plugin_api_public": false,
    "read_timeout": "10s",
    "write_timeout": "10s",
    "read_header_timeout": "5s",
    "max_header_bytes": 1048576
  },
  "plugins": {
    "dir": "plugins",
    "enabled": [
      "minecraft"
    ]
  },
  "logging": {
    "format": "text"
  },
  "udp_record": {
    "enabled": false,
    "path": "logs/udp-record-server.jsonl",
    "duration": "30s",
    "max_events": 5000
  }
}
