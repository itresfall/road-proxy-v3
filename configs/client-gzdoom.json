{
  "listen_addr": "127.0.0.1:5029",
  "listen_network": "udp",
  "server_ws_url": "ws://127.0.0.1:8080/ws",
  "plugin_name": "gzdoom-udp",
  "connect_retries": 6,
  "retry_initial_delay": "100ms",
  "retry_max_delay": "600ms",
  "ws_idle_timeout": "10m0s",
  "ws_ping_interval": "30s",
  "udp_session_idle_timeout": "10m0s",
  "udp_metrics_log_interval": "10s",
  "max_ws_message_bytes": 1048576,
  "buffer_size": 32768,
  "handshake_timeout": "5s",
  "read_timeout": "30s",
  "write_timeout": "30s",
  "enable_compression": false,
  "headers": {},
  "logging": {
    "format": "text"
  },
  "udp_record": {
    "enabled": false,
    "path": "logs/udp-record-client.jsonl",
    "duration": "30s",
    "max_events": 5000
  }
}
