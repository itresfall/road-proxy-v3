{
  "tcp": {
    "listen_addr": "0.0.0.0:0",
    "buffer_size": 32768,
    "dial_timeout": "5s",
    "keep_alive_period": "30s"
  },
  "http": {
    "enabled": true,
    "listen_addr": "0.0.0.0:8080",
    "ws_endpoint": "/ws",
    "ws_idle_timeout": "10m0s",
    "ws_ping_interval": "30s",
    "max_ws_message_bytes": 1048576,
    "enable_compression": false,
    "read_timeout": "10s",
    "write_timeout": "10s",
    "handshake_timeout": "5s",
    "read_header_timeout": "5s",
    "max_header_bytes": 1048576
  },
  "control": {
    "enabled": true,
    "listen_addr": "0.0.0.0:8081",
    "read_timeout": "10s",
    "write_timeout": "10s",
    "read_header_timeout": "5s",
    "max_header_bytes": 1048576
  },
  "plugins": {
    "dir": "plugins",
    "enabled": [
      "lethal-company-udp"
    ]
  },
  "logging": {
    "format": "text"
  },
  "udp_record": {
    "enabled": false,
    "path": "logs/udp-record-server.jsonl",
    "duration": "30s",
    "max_events": 5000
  }
}
