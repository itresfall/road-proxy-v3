{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://road-proxy-v3.local/schema/plugin.v1.json",
  "title": "road-proxy-v3 plugin schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "target",
    "runtime"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "protocols": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "network",
        "address"
      ],
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "menu": {
      "type": "object",
      "required": [
        "server_config",
        "client_config"
      ],
      "properties": {
        "server_config": {
          "type": "string",
          "minLength": 1
        },
        "client_config": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "supports_reconnect": {
          "type": "boolean"
        },
        "supports_multiplex": {
          "type": "boolean"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "experimental",
            "partial",
            "working",
            "broken"
          ]
        },
        "tested_players": {
          "type": "integer",
          "minimum": 0
        },
        "known_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/known_port"
          }
        },
        "launch_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "type",
        "mode"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "builtin",
            "json"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "passthrough",
            "pipeline"
          ]
        },
        "enable_obfuscation": {
          "type": "boolean"
        },
        "udp_peer_broadcast": {
          "type": "boolean",
          "description": "When true for UDP plugins, client-origin packets are also relayed to other active clients of the same plugin. Use only for peer/lockstep UDP games."
        },
        "udp_reply_policy": {
          "type": "string",
          "enum": [
            "any",
            "same_ip",
            "strict"
          ],
          "description": "UDP reply source filter. any preserves legacy behavior, same_ip accepts replies from the target IP on any port, strict accepts only the exact target IP:port."
        },
        "client_pipeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pipeline_step"
          }
        },
        "server_pipeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pipeline_step"
          }
        }
      }
    }
  },
  "$defs": {
    "known_port": {
      "type": "object",
      "required": [
        "network",
        "port"
      ],
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "role": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pipeline_step": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "noop",
            "xor",
            "base64_encode",
            "base64_decode"
          ]
        },
        "key": {
          "type": "string"
        }
      }
    }
  }
}
