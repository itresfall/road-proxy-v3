server {
    listen 80;
    listen [::]:80;
    server_name road.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name road.example.com;

    # Cloudflare Origin Certificate paths.
    ssl_certificate     /etc/ssl/cloudflare/road.example.com.crt;
    ssl_certificate_key /etc/ssl/cloudflare/road.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    # Data plane (WebSocket)
    location /ws {
        proxy_pass http://127.0.0.1:8080/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Data plane info
    location = /api/info {
        proxy_pass http://127.0.0.1:8080/api/info;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Control plane
    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
